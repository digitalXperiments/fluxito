# Fluxito production environment — copy to deploy/.env.prod and fill in.
#   cp deploy/.env.prod.example deploy/.env.prod
# deploy/.env.prod is gitignored and must NEVER be committed. It lives only on
# the prod Mac and survives every `git pull` / deploy.

# ── Required ───────────────────────────────────────────────────────────────
# Min 32 chars. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=

# Fernet key for encrypting stored OAuth tokens.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ── Deployment ───────────────────────────────────────────────────────────────
# Public URL of this instance (used in emails, OAuth redirects, og tags).
APP_BASE_URL=https://your-domain.example.com

# Postgres password — used by docker compose interpolation AND the app's
# DATABASE_URL. Pick something strong.
POSTGRES_PASSWORD=change-me

# ── Google OAuth (sign-in + connected GA4/GTM/Ads data) ──────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── MCP ──────────────────────────────────────────────────────────────────────
MCP_ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback

# ── Optional: outbound email (invites, access approvals). Leave blank to skip ─
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=Fluxito

# ── Optional: error tracking ──────────────────────────────────────────────────
SENTRY_DSN=

# ── Optional: CORS (defaults shown) ───────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://claude.ai,https://chatgpt.com
