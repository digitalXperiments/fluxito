  {
    "tool": "marketing_read",
    "action": "marketo_get_lead",
    "summary": "Adobe Marketo: GET /rest/v1/lead/{id}.json \u2014 a single lead by Marketo id.",
    "group": "ADOBE MARKETO ENGAGE",
    "params": [
      {
        "name": "resource_id",
        "type": "string",
        "required": true,
        "example": "1001",
        "doc": "Marketo lead id."
      },
      {
        "name": "filters",
        "type": "object",
        "required": false,
        "example": {
          "fields": [
            "firstName",
            "email"
          ]
        },
        "doc": "filters.fields (array of strings) to limit returned columns."
      }
    ],
    "platforms": [
      "marketo"
    ],
    "returns": "Raw Marketo REST envelope { requestId, success, result:[{...lead}] } | error"
  },
  {
