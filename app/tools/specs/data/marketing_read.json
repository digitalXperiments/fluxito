[
  {
    "tool": "marketing_read",
    "action": "get_ad_group_performance",
    "summary": "Google Ads ad-group-level performance for a date range, optionally filtered by campaign_id; cached 60s.",
    "group": "PAID ADS (Google / Meta / TikTok / Snap)",
    "params": [
      {
        "name": "platform",
        "type": "string",
        "required": true,
        "enum": [
          "google"
        ],
        "example": "google",
        "doc": "Only 'google' accepts get_ad_group_performance (validation table). meta/tiktok/snap reject it."
      },
      {
        "name": "account_id",
        "type": "string",
        "required": true,
        "example": "123-456-7890",
        "doc": "Google customer id."
      },
      {
        "name": "date_range_start",
        "type": "string",
        "required": false,
        "example": "2026-05-01",
        "doc": "YYYY-MM-DD; not validated."
      },
      {
        "name": "date_range_end",
        "type": "string",
        "required": false,
        "example": "2026-05-31",
        "doc": "YYYY-MM-DD; not validated."
      },
      {
        "name": "campaign_id",
        "type": "string",
        "required": false,
        "example": "987654321",
        "doc": "Optional filter to one campaign."
      },
      {
        "name": "limit",
        "type": "integer",
        "required": false,
        "example": 50,
        "doc": "Max rows. Tool default 50."
      }
    ],
    "platforms": [
      "google"
    ],
    "returns": "{ ad_groups: [...] } | {error,...}"
  },
