  {
    "tool": "analytics_write",
    "action": "create_custom_metric",
    "summary": "GA4-only: create a custom metric. Requires full scope + config{display_name, parameter_name}. Whole config dict is forwarded to the connector.",
    "group": "",
    "params": [
      {
        "name": "platform",
        "type": "string",
        "required": true,
        "enum": [
          "ga4",
          "amplitude",
          "adobe_analytics"
        ],
        "example": "ga4",
        "doc": "GA4 only."
      },
      {
        "name": "property_id",
        "type": "string",
        "required": true,
        "example": "properties/123456789",
        "doc": "GA4 property (auto-prefixed). Passed to connector; not explicitly required-checked.",
        "platforms": [
          "ga4"
        ]
      },
      {
        "name": "config",
        "type": "object",
        "required": true,
        "example": {
          "display_name": "Cart Value",
          "parameter_name": "cart_value"
        },
        "doc": "Must contain truthy display_name and parameter_name. The ENTIRE config dict is passed to ga4.create_custom_metric (so extra keys like measurement_unit/scope flow through unvalidated)."
      },
      {
        "name": "config.measurement_unit / config.scope / others",
        "type": "object",
        "required": false,
        "example": {
          "measurement_unit": "CURRENCY"
        },
        "doc": "Any extra config keys are forwarded verbatim to the connector (unvalidated passthrough)."
      }
    ],
    "platforms": [
      "ga4"
    ],
    "returns": "GA4 create_custom_metric dict | {error,message} | insufficient_scope",
    "scope": "analytics_write",
    "reversible": true
  },
