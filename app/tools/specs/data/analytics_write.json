      },
      {
        "name": "config",
        "type": "object",
        "required": true,
        "example": {
          "name": "Revenue per Visit",
          "rsid": "myrsid",
          "definition": {}
        },
        "doc": "Must contain truthy name, rsid, definition (checked via 'not config.get(k)'). definition is the Adobe calc-metric definition object."
      },
      {
        "name": "config.description",
        "type": "string",
        "required": false,
        "example": "",
        "doc": "Optional description."
      }
    ],
    "platforms": [
      "adobe_analytics"
    ],
    "returns": "Adobe create_calculated_metric dict | {error,message}",
    "scope": "analytics_write",
    "reversible": true
  },
